# Normalise line endings so that diffs stay meaningful on every platform.
#
# The repository previously stored CRLF for text files while the working tree
# held LF. Git hid the difference during comparison, but any checkout on Linux
# or macOS produced a whole-file rewrite, making every diff unreadable.
* text=auto eol=lf

# Windows batch scripts must keep CRLF in order to run.
*.bat text eol=crlf

# Binary assets are never line-ending converted.
*.png binary
*.jar binary
*.jks binary
*.keystore binary