<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer use the platform splash screen API. The icon is
         an adaptive icon so the system applies its own mask instead of
         failing to draw a bare vector. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>

        <item name="android:windowSplashScreenBackground">@color/mess_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/mess_background</item>
    </style>
</resources>