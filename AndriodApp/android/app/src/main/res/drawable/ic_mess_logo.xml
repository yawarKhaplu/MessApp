    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Roof -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,26 L82,50 L76,50 L76,82 L32,82 L32,50 L26,50 Z" />

    <!-- Door, cut visually by overlaying the brand colour -->
    <path
        android:fillColor="#FFE65100"
        android:pathData="M48,82 L48,62 a6,6 0 0 1 12,0 L60,82 Z" />

    <!-- Chimney detail -->
    <path
        android:fillColor="#FFFFFFFF"
