<?xml version="1.0" encoding="utf-8"?>
<!-- Splash mark. Deliberately a large SOLID white disc with the house knocked
     out in the brand colour: a shape with no transparent interior cannot be
     lost against the orange background, whatever mask the system applies. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid disc -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,2 a52,52 0 1,1 0,104 a52,52 0 1,1 0,-104 Z" />

    <!-- House, knocked out -->
    <path
        android:fillColor="#FFE65100"
        android:pathData="M54,26 L78,46 L72,46 L72,74 L36,74 L36,46 L30,46 Z" />

    <!-- Chimney -->
    <path
        android:fillColor="#FFE65100"
        android:pathData="M64,34 L71,34 L71,48 L64,48 Z" />
</vector>