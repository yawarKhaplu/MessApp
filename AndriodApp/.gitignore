# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing secrets - never commit these
android/key.properties
**/*.jks
**/*.keystore

# Local database copies pulled off a device for debugging. These contain real
# expense and payment records and must never reach a remote.
_db/
*.db
*.db-journal
*.db-wal
*.db-shm

# Firebase config belongs to one Firebase project. Not a true secret, since
# access is restricted by package name and signing certificate, but it is
# environment specific so it stays out of git.
android/app/google-services.json

# Local scratch
*.log
*.hprof
google-services.json
